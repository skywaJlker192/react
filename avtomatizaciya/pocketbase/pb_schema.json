[
  {
    "name": "obshchezhitie",
    "type": "base",
    "system": false,
    "listRule": "",
    "viewRule": "",
    "createRule": "status = 'Новая'",
    "updateRule": "status != 'Готово' && @request.body.title:isset = false && @request.body.room:isset = false && @request.body.details:isset = false",
    "deleteRule": "status = 'Готово'",
    "fields": [
      {
        "name": "title",
        "type": "text",
        "required": true,
        "presentable": false,
        "system": false
      },
      {
        "name": "room",
        "type": "text",
        "required": true,
        "presentable": false,
        "system": false
      },
      {
        "name": "category",
        "type": "select",
        "required": true,
        "presentable": false,
        "system": false,
        "maxSelect": 1,
        "values": ["Сантехника", "Электрика", "Мебель", "Интернет"]
      },
      {
        "name": "details",
        "type": "text",
        "required": false,
        "presentable": false,
        "system": false
      },
      {
        "name": "status",
        "type": "select",
        "required": true,
        "presentable": false,
        "system": false,
        "maxSelect": 1,
        "values": ["Новая", "В работе", "Готово"]
      },
      {
        "name": "urgent",
        "type": "bool",
        "required": false,
        "system": false
      },
      {
        "name": "master",
        "type": "text",
        "required": false,
        "presentable": false,
        "system": false
      },
      {
        "name": "created",
        "type": "autodate",
        "onCreate": true,
        "onUpdate": false,
        "system": false
      },
      {
        "name": "updated",
        "type": "autodate",
        "onCreate": true,
        "onUpdate": true,
        "system": false
      }
    ],
    "indexes": [
      "CREATE INDEX idx_obshchezhitie_status ON obshchezhitie (status)"
    ]
  }
]
