      "parameters": {
        "method": "POST",
        "url": "http://ollama:11434/api/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  model: 'qwen2.5:3b',\n  stream: false,\n  format: {\n    type: 'object',\n    properties: {\n      category: { type: 'string', enum: ['Сантехника', 'Электрика', 'Мебель', 'Интернет'] },\n      urgent: { type: 'boolean' },\n      summary: { type: 'string' }\n    },\n    required: ['category', 'urgent', 'summary']\n  },\n  messages: [\n    { role: 'system', content: 'Ты диспетчер общежития №3. Прочитай заявку жителя и верни JSON из трёх полей: категория (Сантехника, Электрика, Мебель, Интернет), срочность и краткое описание до 15 слов. Срочно — если есть потоп, искры, запах гари, или в комнате целиком пропал интернет. Категорию от жителя используй как подсказку, но исправляй её, если она не подходит. Отвечай только JSON.' },\n    { role: 'user', content: 'Заявка: ' + $json.body.title + '\\nКомната: ' + $json.body.room + '\\nКатегория от жителя: ' + $json.body.category + '\\nПодробности: ' + $json.body.details }\n  ]\n} }}",
        "options": {
          "timeout": 120000
        }
      },
      "name": "Классификация",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -200,
        0
      ],
      "id": "4b8cdd8f-2896-451d-badf-88cdad062909"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f1",
              "name": "id",
              "value": "={{ $('Приём заявки').item.json.body.id }}",
              "type": "string"
            },
            {
              "id": "f2",
              "name": "title",
              "value": "={{ $('Приём заявки').item.json.body.title }}",
              "type": "string"
            },
            {
              "id": "f3",
              "name": "room",
              "value": "={{ $('Приём заявки').item.json.body.room }}",
              "type": "string"
            },
            {
              "id": "f4",
              "name": "category",
              "value": "={{ JSON.parse($json.message.content).category }}",
              "type": "string"
            },
            {
              "id": "f5",
              "name": "urgent",
              "value": "={{ JSON.parse($json.message.content).urgent }}",
              "type": "boolean"
            },
            {
              "id": "f6",
              "name": "summary",
              "value": "={{ JSON.parse($json.message.content).summary }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "name": "Разбор ответа",
